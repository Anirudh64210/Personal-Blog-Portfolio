---
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource/figtree/400.css";
import "@fontsource/figtree/500.css";
import "@fontsource/figtree/600.css";
import "@fontsource/figtree/700.css";
import "@fontsource/silkscreen/400.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "../styles/tokens.css";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config";
import { THEME_SCRIPT } from "../lib/theme-script.mjs";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  published?: string;
  modified?: string;
  schema?: object | object[];
  active?: string;
  variant?: "float" | "band";
  bodyClass?: string;
  preloadImage?: string;
  noindex?: boolean;
}
const {
  title = site.title,
  description = site.description,
  image = "/og/default.png",
  imageAlt = "Sai Anirudh Siddi, AI engineer in Las Vegas",
  type = "website",
  published,
  modified,
  schema,
  active,
  variant = "float",
  bodyClass,
  preloadImage,
  noindex = false,
} = Astro.props;

// Canonical URLs never end in a slash, except the home page (matches trailingSlash: "never").
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(path, site.url).href;
const ogImage = new URL(image, site.url).href;

// Anything written into a script tag has to survive HTML parsing first:
// JSON.stringify leaves "<", ">" and "&" alone, so a value that contains a
// closing script tag would end the tag early and let the rest run as markup.
// U+2028/U+2029 are legal in JSON but are line terminators to a JS parser.
// Re-encode all five as JSON unicode escapes, which parse back identically.
const jsonForScript = (v: unknown) =>
  JSON.stringify(v).replace(
    /[\u003c\u003e\u0026\u2028\u2029]/g,
    (c) => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"),
  );
---
<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <!-- Sets data-theme before the stylesheet loads, so there is no flash of the wrong theme. Hashed in the CSP. -->
    <script is:inline set:html={THEME_SCRIPT}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="author" content={site.name} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#EDE6D8" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=2" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · Writing`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} type={preloadImage.endsWith(".webp") ? "image/webp" : undefined} fetchpriority="high" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    {type === "website" && <meta property="profile:first_name" content="Sai Anirudh" />}
    {type === "website" && <meta property="profile:last_name" content="Siddi" />}
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    {type === "article" && <meta property="article:author" content={site.url} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {schema && <script type="application/ld+json" set:html={jsonForScript(schema)} />}
  </head>
  <body class:list={[bodyClass]}>
    <a class="skip" href="#main">Skip to content</a>
    <Header active={active} variant={variant} />
    <slot name="before-main" />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Bundled, not inline: the CSP allows only 'self' plus build-time hashes. -->
    <script>
      import "../scripts/site";
    </script>
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
