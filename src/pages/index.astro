---
import Base from "../layouts/Base.astro";
import Terminal from "../components/Terminal.astro";
import Writing from "../components/Writing.astro";
import Work from "../components/Work.astro";
import Wins from "../components/Wins.astro";
import XpLog from "../components/XpLog.astro";
import Contact from "../components/Contact.astro";
import { site, hero } from "../config";
import { getPosts } from "../lib/posts";
import { graph, person, website, profilePage } from "../lib/schema";

const posts = await getPosts();
const schema = graph(person, website, profilePage("/"));

// "hi, i'm ani." is set in bold ink; the rest of the first paragraph follows it.
const [first, ...more] = hero.intro;
const lead = "hi, i'm ani.";
const firstRest = first.startsWith(lead) ? first.slice(lead.length) : first;
---
<Base schema={schema} preloadImage="/portrait-hero.webp" active="home">
  <section class="wrap hero" aria-labelledby="name-h">
    <div class="hero-card">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 id="name-h" class="hero-h1">{site.name}</h1>
      <div class="hero-intro">
        <p>{first.startsWith(lead) && <b>{lead}</b>}{firstRest}</p>
        {more.map((p) => <p>{p}</p>)}
      </div>
      <div class="hero-cta">
        <a class="btn btn--solid" href="/blog">Read the blog</a>
        <a class="btn" href="/resume">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          View résumé
        </a>
        <a class="btn btn--text" href="#contact">Say hi →</a>
      </div>
    </div>
    <div class="hero-photo">
      <figure class="print">
        <picture>
          <source srcset="/portrait-hero.webp" type="image/webp" />
          <img
          src={site.portrait}
          alt={site.portraitAlt}
          width="624"
          height="800"
          fetchpriority="high"
          decoding="async"
          />
        </picture>
        <figcaption>{hero.photoCaption}</figcaption>
      </figure>
    </div>
  </section>

  <Terminal />
  <Writing posts={posts} />
  <Work posts={posts} />
  <Wins />
  <XpLog />
  <Contact />
</Base>
