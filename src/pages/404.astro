---
import Base from "../layouts/Base.astro";
import { site } from "../config";
---
<Base title={`Page not found · ${site.name}`} description="This page does not exist. Head back home or browse the writing." noindex>
  <div class="wrap">
    <div class="lost">
      <span class="eyebrow">Error 404 · quest not found</span>
      <h1 class="page-title">This page wandered off.</h1>
      <p>the link might be old, or the page moved. everything that exists is one click away from here.</p>
      <div class="hero-cta">
        <a class="btn btn--solid" href="/">Back home</a>
        <a class="btn" href="/blog">Read the blog</a>
        <a class="btn btn--text" href="/experience">Experience →</a>
      </div>
    </div>
  </div>
</Base>
