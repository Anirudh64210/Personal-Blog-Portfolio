---
// Timeline rows for Experience / Education.
// `slug` selects the accent colour from CSS; no inline style attribute is used
// anywhere here, because the site's CSP blocks them.
// Each row leads with a logo tile. With a `logo` set, `plate` decides how it
// sits: "light" on a white chip, "full" filling the tile edge to edge. Rows
// with no logo fall back to a tinted `mark` monogram.
type Rec = {
  yr: string;
  role: string;
  org: string;
  loc: string;
  mark?: string;
  slug?: string;
  logo?: string;
  plate?: "light" | "full";
};

const { items } = Astro.props as { items: Rec[] };
---

<ul class="rec reveal">
  {items.map((e) => (
    <li>
      <span class={`lg lg--${e.logo ? (e.plate ?? "light") : "mark"}${e.slug ? ` lg-${e.slug}` : ""}`}>
        {e.logo ? (
          <img src={e.logo} alt={`${e.role} logo`} width="112" height="112" loading="lazy" decoding="async" />
        ) : (
          <span class="lg-mark">{(e.mark ?? e.role.slice(0, 2)).toUpperCase()}</span>
        )}
      </span>
      <span class="yr">{e.yr}</span>
      <span class="rec-main">
        <span class="role">{e.role}</span><br />
        <span class="org">{e.org}</span>
      </span>
      <span class="loc2">{e.loc}</span>
    </li>
  ))}
</ul>
