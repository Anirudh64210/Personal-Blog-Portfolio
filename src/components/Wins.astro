---
import { wins } from "../config";
// Plain list, not cards. Only real links: an item without href renders as text with no arrow.
---
<section class="wrap section" id="wins" aria-labelledby="wins-h">
  <div class="section-head">
    <div class="titles">
      <span class="eyebrow">Trophy room</span>
      <h2 id="wins-h" class="h2">Wins and press</h2>
    </div>
  </div>
  <ul class="wins">
    {wins.map((w) => {
      const inner = (
        <>
          <span class:list={["tag", w.tag === "WIN" ? "tag--amber" : "tag--ink"]}>{w.tag}</span>
          <span class="win-date">{w.date}</span>
          <span class="win-title">{w.title}</span>
          <span class="win-src">{w.source}</span>
        </>
      );
      return (
        <li>
          {w.href ? (
            <a class="win" href={w.href} target="_blank" rel="noopener noreferrer">
              {inner}
              <span class="win-go" aria-hidden="true">↗</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          ) : (
            <div class="win">{inner}</div>
          )}
        </li>
      );
    })}
  </ul>
</section>
