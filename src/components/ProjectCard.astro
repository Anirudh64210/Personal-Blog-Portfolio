---
// `num` is the card's position in the grid, passed in by the page. It only
// drives the morse numeral thumb, so the config never has to renumber on a reorder.
const { p, num } = Astro.props as {
  p: { code: string; title: string; summary: string; tags: string[]; repo?: string; upcoming?: boolean };
  num: number;
};
const NUM: Record<number, string> = { 1: ".----", 2: "..---", 3: "...--", 4: "....-", 5: "....." };
const marks = [...(NUM[num] || "")].map((s) => (s === "." ? "dot" : "dash"));

// Nothing to open yet, so the card becomes a plain tile rather than a dead link.
const Tag = p.repo ? "a" : "div";
const link = p.repo ? { href: p.repo, target: "_blank", rel: "noopener" } : {};
---
<Tag class:list={["proj", "reveal", { "proj--soon": !p.repo }]} {...link} data-code={p.code}>
  <div class="mthumb">
    {marks.map((c) => <i class={`mk ${c}`}></i>)}
  </div>
  <span class="code" data-text={p.code}>{p.code}</span>
  <h3>{p.title}</h3>
  <p>{p.summary}</p>
  <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
  <span class="open">{p.repo ? "Open dossier →" : "Upcoming"}</span>
</Tag>
